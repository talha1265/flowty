# ==========================================
# FLOWTY PLATFORM ENVIRONMENT CONFIGURATION
# ==========================================

# 1. DATABASE (Neon Serverless PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-something.us-east-2.aws.neon.tech/flowty?sslmode=require"

# 2. PAYU PAYMENT GATEWAY CREDENTIALS
PAYU_MERCHANT_KEY="YOUR_PAYU_MERCHANT_KEY"
PAYU_MERCHANT_SALT="YOUR_PAYU_MERCHANT_SALT"
PAYU_MODE="test"
PAYU_BASE_URL="https://test.payu.in/_payment"

# 3. APPLICATION & SECURITY
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-generated-jwt-secret-key"

# 4. PLATFORM COMMISSIONS & ESCROW
PLATFORM_FEE_PERCENTAGE="5"
ESCROW_AUTO_RELEASE_DAYS="7"
